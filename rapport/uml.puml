@startuml
skinparam classAttributeIconSize 0
skinparam defaultFontSize 14
skinparam classFontSize 16
skinparam dpi 200
skinparam shadowing false
skinparam packageStyle rectangle
skinparam linetype ortho

skinparam class {
    BackgroundColor White
    BorderColor Black
    ArrowColor Black
}

abstract class Piece {
    - color : Color
    - row : int
    - col : int
    - hasMoved : boolean
    - board : Board
    --
    + {abstract} getAccessibleCases() : List<Case>
    + canMoveTo(target : Case) : boolean
    + getCasesInDirection(dRow, dCol) : List<Case>
    + getUnicodeSymbol() : String
}

class Pawn
class Rook
class Knight
class Bishop
class Queen
class King {
    - addCastlingMoves()
}

Piece <|-- Pawn
Piece <|-- Rook
Piece <|-- Knight
Piece <|-- Bishop
Piece <|-- Queen
Piece <|-- King

class Board {
    - pieces : Piece[][]
    - selectedCase : Case
    - passingCaptureTarget : Case
    - capturedByWhite : List<Piece>
    - capturedByBlack : List<Piece>
    --
    + movePiece(from, to) : boolean
    + undoMove(from, to, captured)
    + getLegalMoves(piece : Piece) : List<Case>
    + isKingInCheck(color) : boolean
    + isKingInCheckmate(color) : boolean
    + isStalemate(color) : boolean
    + isSquareAttackedBy(row, col, color) : boolean
    + reset()
}

class GameEngine {
    - isWhiteTurn : boolean
    - started : boolean
    - paused : AtomicBoolean
    - ended : AtomicBoolean
    - player1TimeRemaining : AtomicInteger
    - player2TimeRemaining : AtomicInteger
    - unlimitedTime : boolean
    - player1History : History
    - player2History : History
    --
    + start(player1Type, player2Type, time, preset)
    + stop()
    + pause() / resume()
    + selectCase(c : Case)
    + undo(playerNumber)
    + giveUp(playerNumber)
    + end(winnerNumber)
}

class "<<record>>\nCase" as Case {
    - row : int
    - col : int
    --
    + isValid() : boolean
}

class History {
    - entries : List<Entry>
    --
    + add(entry : Entry)
    + removeLast() : Entry
    + getFormattedList() : List<String>
    + clear()
    + isEmpty() : boolean
}

class "<<record>>\nHistory.Entry" as HistoryEntry {
    - piece : Piece
    - from : Case
    - to : Case
    - captured : Piece
    --
    - format() : String
}

interface BoardObserver {
    + onCaseSelected(e : BoardEvent)
    + onPieceMoved(e : BoardEvent)
    + onPieceCaptured(e : BoardEvent)
}

interface GameEngineObserver {
    + onGameStarted(e)
    + onGamePaused(e)
    + onGameResumed(e)
    + onGameStopped(e)
    + onGameEnded(e)
    + onPlayerTurnChanged(e)
    + onGameTimeUpdated(e)
}

interface HistoryObserver {
    + onChange(e : HistoryEvent)
}

Board "1" o-- "0..*" Piece : contains >
GameEngine "1" *-- "1" Board : owns >
GameEngine "1" *-- "2" History : owns >
Board ..> Case : <<use>>
History "1" --> "*" HistoryObserver : notifies >
History *-- HistoryEntry : contains >
Board "1" --> "*" BoardObserver : notifies >
GameEngine "1" --> "*" GameEngineObserver : notifies >

@enduml
